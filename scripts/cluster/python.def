# Python environment for the grid runner and the analysis pipeline.
#   apptainer build --fakeroot $HOME/sif/python.sif scripts/cluster/python.def
# (or build on a workstation and copy the .sif to the cluster)
Bootstrap: docker
From: python:3.12-slim

%post
    pip install --no-cache-dir \
        pyyaml==6.0.2 numpy==2.1.3 pandas==2.2.3 scipy==1.14.1 \
        matplotlib==3.9.2 pytest==8.3.3

%test
    python3 -c "import yaml, numpy, pandas, scipy, matplotlib, pytest"
