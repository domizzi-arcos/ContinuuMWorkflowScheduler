# Generation window in seconds.
# After this time the task generator stops creating new instances, while the
# scheduler/workers/collector continue until the remaining work is finished.
# 0 means "generate until manually stopped".
EXPERIMENT_DURATION_SECONDS=180

# Periodic progress log cadence in seconds.
EXPERIMENT_PROGRESS_LOG_SECONDS=10

# Directory inside the container where experiment logs are written.
# docker-compose mounts ./logs from the host to this path.
EXPERIMENT_LOG_DIR=/root/logs
